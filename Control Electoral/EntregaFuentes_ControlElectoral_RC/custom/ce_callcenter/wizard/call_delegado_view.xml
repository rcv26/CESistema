<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="view_call_center_wizard_form" model="ir.ui.view">
        <field name="name">call_delegado.wizard.form</field>
        <field name="model">ce_callcenter.call_delegado.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar informacion">
                    <group>
                        <group>
                            <field name="delegado_id" attrs="{'invisible':True}"/>
                            <field name="celular"/>
                            <field name="cedula"/>
                            <field name="nombres"/>
                            <field name="pregunta1" widget="radio"/>
                            <field name="operadora" force_save="1"/>
                            <field name="email" force_save="1"/> 

                        </group>
                        <group>
                            <!-- <field name="call_duration_timer" widget="web_time_counter"
                                   options="{'widget_start_field': 'date_start', 'widget_stop_field': 'date_end'}"/> -->
			    <field name="call_count"/>
                            <field name="tipo_delegado"/>
                            <field name="cod_recinto"/>
                            <field name="cod_provincia"/>
                            <field name="cod_canton"/>
                            <field name="cod_parroquia"/>
                            <field name="cod_zona"/>
                            <field name="genero"/>
                            <field name="numero_junta"/>
                        </group>
                        <group>
                            <field name="pregunta2" widget="radio"/>
                        </group>
                        <group>
                            <field name="whatsapp" widget="radio" required="1"/>
                        </group>
                        <footer>
                            <button string="Contesto" name="contesto" type="object" class="oe_highlight"/>
                            <button string="NO Contesto" name="no_contesto" type="object" class="btn btn-secondary"/>
                            <button string="Numero Incorrecto" name="num_incorrecto" type="object" class="btn btn-secondary"/>
                        </footer>
                    </group>
            </form>
        </field>
    </record>


<record model="ir.actions.act_window" id="action_call_center_wizard">
    <field name="name">Realizar Llamada</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">ce_callcenter.call_delegado.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_call_center_wizard_form"/>
    <field name="target">new</field>
</record>
</odoo>