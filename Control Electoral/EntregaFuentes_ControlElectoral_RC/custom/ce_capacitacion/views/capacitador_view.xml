<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_capacitador_tree" model="ir.ui.view">
        <field name="name">capacitador.tree</field>
        <field name="model">ce_capacitacion.capacitador</field>
        <field name="arch" type="xml">
            <tree string="Capacitador">
                <field name="cedula"/>
                <field name="nombres"/>
                <field name="genero"/>
                <field name="celular"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <record id="view_capacitador_form" model="ir.ui.view">
        <field name="name">capacitador.tree</field>
        <field name="model">ce_capacitacion.capacitador</field>
        <field name="arch" type="xml">
            <form string="Capacitador">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_capacitacion" type="object" class="oe_stat_button" icon="fa-pencil-square">
                            <field string="Capacitacion" name="capacitacion_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="cedula" string="Identificacion" class="oe_edit_only"/>
                        <h1>
                            <field name="cedula" placeholder="Identificacion del Capacitador"/>
                        </h1>
                    </div>
                    <group>
                        <label for="nombres" string="Nombre Completo" class="oe_edit_only"/>
                        <field name="nombres" attrs="{'readonly':True}" force_save="1" placeholder="Nombres del Capacitador"/>
                    <group>
                        <field name="genero" attrs="{'readonly':True}" force_save="1" widget="radio"/>
                        <field name="email" widget="email"/>
                    </group>
                    <group>
                        <field name="celular"/>
                        <field name="operadora" widget="radio"/>
                    </group>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>       
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_capacitador">
        <field name="name">Capacitador</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_capacitacion.capacitador</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="ce_capacitacion.view_capacitador_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Capacitador.
            </p>
        </field>
    </record>

</odoo>