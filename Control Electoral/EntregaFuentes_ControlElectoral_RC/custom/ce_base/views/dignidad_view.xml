<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dignidad_tree" model="ir.ui.view">
        <field name="name">dignidad.tree</field>
        <field name="model">ce_base.dignidad</field>
        <field name="arch" type="xml">
            <tree string="dignidad">
                <field name="nombre"/>
                <field name="nivel"/>
                <field name="cod_provincia"/>
                <field name="cod_canton"/>
            </tree>
        </field>
    </record>

    <record id="view_dignidad_form" model="ir.ui.view">
        <field name="name">dignidad.form</field>
        <field name="model">ce_base.dignidad</field>
        <field name="arch" type="xml">
            <form string="dignidad">
                <sheet>
                    <div class="oe_title">
                        <label for="nombre" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nombre" placeholder="Nombre de la dignidad ej. Alcalde"/>
                        </h1>
                        <group>
                        <group>
                            <field name="nivel"/>
                            <field name="estado"/>
                        </group>
                        <group>
                            <field name="cod_provincia"/>
                            <field name="cod_canton"/>
                        </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_dignidad">
        <field name="name">Dignidad</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.dignidad</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>