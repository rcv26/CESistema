<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_delegadojrv_filter" model="ir.ui.view">
        <field name="name">delegado.filter</field>
        <field name="model">ce_base.delegado</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Delagado">
                <field name="cedula"/>
                <field name="nombres"/>
                <field name="celular"/>
                <separator/>
                <filter string="Hombre" name="genero" domain="[('genero','=','M')]"/>
                <filter string="Mujer" name="genero" domain="[('genero','=','F')]"/>
                <!-- <newline/>
                <group expand="0" string="Group By...">
                    <filter string="Birthday" name="birthday_groupby" domain="[]" context="{'group_by':'birthday'}"/>
                    <filter string="Company" name="company_group" domain="[]" context="{'group_by':'company_id'}"/>
                </group> -->
            </search>
        </field>
    </record>

    <record id="view_delegado_tree" model="ir.ui.view">
        <field name="name">delegado.tree</field>
        <field name="model">ce_base.delegado</field>
        <field name="arch" type="xml">
            <tree string="Delegado">
                <field name="cedula"/>
                <field name="nombres"/>
                <field name="genero" widget="radio"/>
                <field name="referencia1"/>
                <field name="referencia2"/>
                <field name="referencia3"/>
                <field name="referencia4"/>
                <field name="tipo_ingreso"/>
                <field name="estado"/>
                <field name="juntas_count"/>
            </tree>
        </field>
    </record>

    <record id="view_delegado_form" model="ir.ui.view">
        <field name="name">delegado.form</field>
        <field name="model">ce_base.delegado</field>
        <field name="arch" type="xml">
            <form string="Delegado">
             <header>
                    <button name="asignacion_directa" type="object"
                            groups="ce_base.group_electoral_supervisor" string="Asignacion Directa"
                            attrs="{'readonly': [('id', '!=', False),('tipo_delegado','=','dcdr')]}"
                            class="oe_highlight"/>
            </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_juntas" type="object" class="oe_stat_button" icon="fa-wpforms">
                            <field string="Juntas" name="juntas_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="cedula" string="Identificacion" class="oe_edit_only"/>
                        <h1>
                            <field name="cedula" placeholder="Identificacion del Delegado" attrs="{'readonly': [('id', '!=', False)]}"/>
                        </h1>
                    </div>
                    <group>
                        <label for="nombres" string="Nombre Completo" class="oe_edit_only"/>
                        <field name="nombres" attrs="{'readonly':True}" force_save="1" placeholder="Nombres del Delegado"/>
                        <group>
                            <field name="celular" widget="phone"/>
                            <field name="operadora"/>
                            <field name="email" widget="email"/>
                            <field name="referencia1" string="Referencia Directa" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia2" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia3" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia4" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                        </group>
                        <group>
                            <field name="cod_provincia" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_canton" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_parroquia" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_zona" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_recinto" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="genero" attrs="{'readonly':True}" force_save="1" widget="radio"/>
                            <field name="numero_junta" attrs="{'readonly':True}" force_save="1" widget="radio"/>
                            <field name="tipo_delegado" invisible='1'/>
                            <field name="estado" groups="ce_base.group_electoral_manager"/>
                        </group>
                        <field name="juntas_ids" mode="tree,form" widget="many2one">
                            <tree string="Delegado">
                                <field name="cod_provincia" string="Provincia"/>
                                <field name="cod_canton" string="Canton" />
                                <field name="cod_parroquia" string="Parroquia" />
                                <field name="cod_zona" string="Zona" />
                                <field name="cod_recinto" string="Recinto" />
                                <field name="genero" string="Genero"/>
                                <field name="numero_junta" string="Junta"/>
                            </tree>
                            <form>
                                <group>
                                    <group>
                                        <field name="cod_provincia" string="Provincia"/>
                                        <field name="cod_canton" string="Canton"/>
                                        <field name="cod_parroquia" string="Parroquia"/>
                                        <field name="cod_zona" string="Zona"/>
                                    </group>
                                    <group>
                                        <field name="cod_recinto" string="Recinto"/>
                                        <field name="genero" string="Genero"/>
                                        <field name="numero_junta" string="Junta"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delegado_coordinador_tree" model="ir.ui.view">
        <field name="name">delegado_coordinador.tree</field>
        <field name="model">ce_base.delegado</field>
        <field name="arch" type="xml">
            <tree string="Delegados Coordinadores">
                <field name="cedula"/>
                <field name="nombres"/>
                <field name="genero" widget="radio"/>
                <field name="referencia1"/>
                <field name="referencia2"/>
                <field name="referencia3"/>
                <field name="coor_recinto_id"/>
                <field name="tipo_ingreso"/>
                <field name="estado"/>
            </tree>
        </field>
    </record>

    <record id="view_delegado_coordinador_form" model="ir.ui.view">
        <field name="name">delegado_coordinador.form</field>
        <field name="model">ce_base.delegado</field>
        <field name="arch" type="xml">
            <form string="Delegados Coordinadores">
                <header>
                    <button name="asignacion_directa_coordinador" type="object"
                            groups="ce_base.group_electoral_supervisor" string="Asignacion Directa Recinto"
                            attrs="{'readonly': [('id', '!=', False),('tipo_delegado','=','dcdr')]}"
                            class="oe_highlight"/>
            </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">

                    </div>
                    <div class="oe_title">
                        <label for="cedula" string="Identificacion" class="oe_edit_only"/>
                        <h1>
                            <field name="cedula" placeholder="Identificacion del Delegado"/>
                        </h1>
                    </div>
                    <group>
                        <label for="nombres" string="Nombre Completo" class="oe_edit_only"/>
                        <field name="nombres" attrs="{'readonly':True}" force_save="1" placeholder="Nombres del Delegado"/>
                        <group>
                            <field name="celular" widget="phone"/>
                            <field name="operadora"/>
                            <field name="email" widget="email"/>
                            <field name="referencia1" string="Referencia Directa" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia2" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia3" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="referencia4" force_save="1" attrs="{'readonly':True}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                        </group>
                        <group>
                            <field name="cod_provincia" invisible='1' attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_canton" invisible='1' attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_parroquia" invisible='1' attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_zona" invisible='1' attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <!-- <field name="cod_recinto" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/> -->
                            <field name="cod_recinto" string="Recinto de Votacion" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="coor_recinto_id" string="Recinto que Coordino" attrs="{'readonly':True}" force_save="1" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="genero"  invisible='1' attrs="{'readonly':True}" force_save="1" widget="radio"/>
                            <field name="numero_junta" invisible='1' attrs="{'readonly':True}" force_save="1" widget="radio"/>
                            <field name="tipo_delegado" invisible='1' />
                            <field name="tipo_ingreso" groups="ce_base.group_electoral_manager,ce_base.group_electoral_supervisor"/>
                            <field name="estado" groups="ce_base.group_electoral_manager,ce_base.group_electoral_supervisor"/>
                        </group>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delegado_graph" model="ir.ui.view">
        <field name="model">ce_base.delegado</field>
        <field name="groups_id" eval="[(4, ref('ce_base.group_electoral_supervisor'))]"/>
        <field name="arch" type="xml">
            <graph string="Delegado">
                <field name="genero"/>
            </graph>
        </field>
    </record>

    <record id="view_delegado_pivot" model="ir.ui.view">
        <field name="model">ce_base.delegado</field>
        <field name="groups_id" eval="[(5, ref('ce_base.group_electoral_supervisor'))]"/>
        <field name="arch" type="xml">
            <pivot string="Delegado">
                <field name="genero"/>
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_delegadojrv">
        <field name="name">DELEGADO JRV</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_delegadojrv_filter"/>
        <field name="view_id" ref="ce_base.view_delegado_tree"/>
        <field name="domain">[('tipo_delegado','=','djrv')]</field>
        <field name="context">{'default_tipo_delegado':'djrv'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Delegado JRV.
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_coordinadorreciento">
        <field name="name">COORDINADOR DE RECINTO</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="view_id" ref="ce_base.view_delegado_coordinador_tree"/>
        <field name="domain">[('tipo_delegado','=','dcdr')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
               (0, 0, {'view_mode': 'tree', 'view_id': ref('view_delegado_coordinador_tree')}),
               (0, 0, {'view_mode': 'form', 'view_id': ref('view_delegado_coordinador_form')})]"/>

        <field name="context">{'default_tipo_delegado':'dcdr'}</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a COORDINADOR DE RECINTO.
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_delegadocda">
        <field name="name">DELEGADO A CDA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">tree,form, graph,pivot</field>
        <field name="view_id" ref="ce_base.view_delegado_tree"/>
        <field name="domain">[('tipo_delegado','=','dcda')]</field>
        <field name="context">{'default_tipo_delegado':'dcda'}</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a DELEGADO A CDA.
            </p>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_delegadojp">
        <field name="name">DELEGADO JUNTA PROVINCIAL</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="view_id" ref="ce_base.view_delegado_tree"/>
        <field name="domain">[('tipo_delegado','=','djp')]</field>
        <field name="context">{'default_tipo_delegado':'djp'}</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a DELEGADO JUNTA PROVINCIAL.
            </p>
        </field>
    </record>

</odoo>