<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_llamada_tree" model="ir.ui.view">
        <field name="name">llamada.tree</field>
        <field name="model">ce_callcenter.llamada</field>
        <field name="arch" type="xml">
            <tree string="LLAMADAS">
                <field name="intento"/>
                <field name="fecha_ini"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
                <field name="pregunta1"/>
                <field name="pregunta2"/>
                <field name="create_uid" string="Creado por"/>
            </tree>
        </field>
    </record>

    <record id="view_llamada_graph" model="ir.ui.view">
        <field name="model">ce_callcenter.llamada</field>
        <field name="arch" type="xml">
            <graph>
                <field name="create_uid" string="Creado por"/>
            </graph>
        </field>
    </record>

    <record id="view_llamada_pivot" model="ir.ui.view">
        <field name="model">ce_callcenter.llamada</field>
        <field name="arch" type="xml">
            <pivot>
                <!-- <field name="genero"/> -->
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_llamada">
        <field name="name">LLAMADAS</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_callcenter.llamada</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>