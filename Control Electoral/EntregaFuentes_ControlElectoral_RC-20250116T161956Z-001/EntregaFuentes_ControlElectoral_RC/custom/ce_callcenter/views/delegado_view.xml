        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="ce_callcenter.view_callcenter_delegado_graph"/>
    </record>





</odoo>