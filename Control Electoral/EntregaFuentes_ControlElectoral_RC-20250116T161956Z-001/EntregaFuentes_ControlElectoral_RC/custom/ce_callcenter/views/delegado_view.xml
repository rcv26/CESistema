    <record model="ir.actions.act_window" id="action_delegado_administrador_call_center">
        <field name="name">DELEGADOS CALL CENTER</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.delegado</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_delegado_administrador_filter"/>
<!--        <field name="domain">[('estado','=','i')]</field>-->

        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_call_center_delegado_administrador_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_call_center_delegado_administrador_form')})]"/>
    </record>


    <!-- resumen -->
    <record id="view_callcenter_delegado_graph" model="ir.ui.view">
        <field name="model">ce_base.delegado</field>
        <field name="arch" type="xml">
            <graph string="DELEGADOS CALL CENTER" type="bar" orientation="horizontal">
                <field name="tipo_ingreso"/>
                <field name="estado" operator="+"/>
<!--                <field name="genero" operator="+"/>-->
            </graph>
        </field>
    </record>

    <record id="view_delegado_pivot" model="ir.ui.view">
        <field name="model">ce_base.delegado</field>
        <field name="groups_id" eval="[(5, ref('ce_base.group_electoral_supervisor'))]"/>
        <field name="arch" type="xml">
            <pivot string="DELEGADOS CALL CENTER">
                <field name="tipo_ingreso"/>
                <field name="estado" operator="+"/>
            </pivot>
        </field>
    </record>
    
    
    <record model="ir.actions.act_window" id="action_delegado_call_center_resumen">
