<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_provincia_tree" model="ir.ui.view">
        <field name="name">provincia.tree</field>
        <field name="model">ce_base.provincia</field>
        <field name="arch" type="xml">
            <tree string="PROVINCIA">
                <field name="cod_provincia"/>
                <field name="nom_prov"/>
            </tree>
        </field>
    </record>

    <record id="view_provincia_form" model="ir.ui.view">
        <field name="name">provincia.form</field>
        <field name="model">ce_base.provincia</field>
        <field name="arch" type="xml">
            <form string="PROVINCIA">
                <sheet>
                    <div class="oe_title">
                        <label for="nom_prov" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nom_prov" placeholder="Nombre de la Provincia"/>
                        </h1>
                        <group>
                        <group><field name="cod_provincia"/></group>
                        </group>
                        
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_provincia">
        <field name="name">PROVINCIA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.provincia</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>