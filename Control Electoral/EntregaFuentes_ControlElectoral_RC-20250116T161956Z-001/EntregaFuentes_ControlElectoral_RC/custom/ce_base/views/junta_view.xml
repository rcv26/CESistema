    <record id="view_junta_filter" model="ir.ui.view">
        <field name="name">junta.filter</field>
        <field name="model">ce_base.junta</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Juntas">
                <field name="cod_recinto"/>
              </search>
        </field>
    </record>

    <record id="view_junta_graph" model="ir.ui.view">
        <field name="model">ce_base.junta</field>
        <field name="arch" type="xml">
            <graph>
                <field name="genero"/>
            </graph>
        </field>
    </record>

    <record id="view_junta_pivot" model="ir.ui.view">
        <field name="model">ce_base.junta</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="genero"/>
                <field name="numero_junta"/>
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_junta">
        <field name="name">JUNTAS</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.junta</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_junta_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Junta.
            </p>
        </field>
    </record>

</odoo>