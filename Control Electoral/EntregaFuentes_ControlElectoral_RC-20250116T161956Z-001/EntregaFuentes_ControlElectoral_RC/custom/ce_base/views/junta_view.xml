<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_junta_tree" model="ir.ui.view">
        <field name="name">junta.tree</field>
        <field name="model">ce_base.junta</field>
        <field name="arch" type="xml">
            <tree string="JUNTAS">
                <field name="cod_provincia" string="Provincia"/>
                <field name="cod_canton" string="Canton"/>
                <field name="cod_parroquia" string="Parroquia"/>
                <field name="cod_zona" string="Zona"/>
                <field name="cod_recinto" string="Recinto"/>
                <field name="genero" string="Genero"/>
                <field name="numero_junta" string="Junta"/>
                <field name="delegado_id" string="Delegado"/>
                <field name="tiene_delegado" optional="hide"/>
                <field name="cedula" string="Cedula Delegado" optional="hide"/>
                <field name="tipo_ingreso_delegado" string="Tipo de Ingreso Delegado" optional="hide"/>
                <field name="estado_delegado" string="Estado Delegado" optional="hide"/>
                <field name="distrito" string="Distrito" optional="hide"/>

            </tree>
        </field>
    </record>
