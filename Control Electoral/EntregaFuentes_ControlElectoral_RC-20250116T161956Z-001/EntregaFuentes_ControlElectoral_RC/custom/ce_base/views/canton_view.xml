<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_canton_tree" model="ir.ui.view">
        <field name="name">canton.tree</field>
        <field name="model">ce_base.canton</field>
        <field name="arch" type="xml">
            <tree string="CANTON">
                <field name="cod_canton"/>
                <field name="nom_canton"/>
                <field name="cod_provincia"/>
            </tree>
        </field>
    </record>

    <record id="view_canton_form" model="ir.ui.view">
        <field name="name">canton.form</field>
        <field name="model">ce_base.canton</field>
        <field name="arch" type="xml">
            <form string="CANTON">
                <sheet>
                    <div class="oe_title">
                        <label for="nom_canton" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nom_canton" placeholder="Nombre del Canton"/>
                        </h1>
                        <group>
                        <group><field name="cod_canton"/></group>
                        <group><field name="cod_provincia" string="Provincia"/></group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_canton">
        <field name="name">CANTON</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.canton</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>