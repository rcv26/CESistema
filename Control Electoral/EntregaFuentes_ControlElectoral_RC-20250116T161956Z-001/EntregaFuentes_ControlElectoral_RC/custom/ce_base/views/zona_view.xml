<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_zona_tree" model="ir.ui.view">
        <field name="name">zona.tree</field>
        <field name="model">ce_base.zona</field>
        <field name="arch" type="xml">
            <tree string="ZONA">
                <field name="cod_zona"/>
                <field name="nom_zona"/>
            </tree>
        </field>
    </record>

    <record id="view_zona_form" model="ir.ui.view">
        <field name="name">zona.form</field>
        <field name="model">ce_base.zona</field>
        <field name="arch" type="xml">
            <form string="ZONA">
                <sheet>
                    <div class="oe_title">
                        <label for="nom_zona" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nom_zona" placeholder="Nombre de la zona"/>
                        </h1>
                        <group>
                        <group><field name="cod_parroquia"/></group>
                        </group>
                        
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_zona">
        <field name="name">ZONA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.zona</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>