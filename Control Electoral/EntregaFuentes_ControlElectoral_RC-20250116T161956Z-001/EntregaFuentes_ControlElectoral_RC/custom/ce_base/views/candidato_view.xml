<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_candidato_tree" model="ir.ui.view">
        <field name="name">Candidato.tree</field>
        <field name="model">ce_base.candidato</field>
        <field name="arch" type="xml">
            <tree string="Candidato">
                <field name="nombres"/>
                <field name="partido"/>
                <field name="orden"/>
                <field name="dignidad_id"/>
            </tree>
        </field>
    </record>

    <record id="view_dignidad_form" model="ir.ui.view">
        <field name="name">candidato.form</field>
        <field name="model">ce_base.candidato</field>
        <field name="arch" type="xml">
            <form string="candidato">
                <sheet>
                    <div class="oe_title">
                        <label for="nombres" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nombres" placeholder="Nombre del candidato"/>
                        </h1>
                        <group>
                        <group>
                            <field name="partido"/>
                            <field name="orden"/>
                        </group>
                        <group>
                            <field name="dignidad_id"/>
                        </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_candidato">
        <field name="name">Candidato</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.candidato</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>