<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_parroquia_tree" model="ir.ui.view">
        <field name="name">parroquia.tree</field>
        <field name="model">ce_base.parroquia</field>
        <field name="arch" type="xml">
            <tree string="PARROQUIA">
                <field name="cod_parroquia"/>
                <field name="nom_parroquia"/>
            </tree>
        </field>
    </record>

    <record id="view_parroquia_form" model="ir.ui.view">
        <field name="name">parroquia.form</field>
        <field name="model">ce_base.parroquia</field>
        <field name="arch" type="xml">
            <form string="PARROQUIA">
                <sheet>
                    <div class="oe_title">
                        <label for="nom_parroquia" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nom_parroquia" placeholder="Nombre de la parroquia"/>
                        </h1>
                        <group>
                        <group><field name="cod_canton"/></group>
                        </group>
                        
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_parroquia">
        <field name="name">PARROQUIA</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.parroquia</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>