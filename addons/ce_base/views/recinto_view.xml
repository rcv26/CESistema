<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_recinto_tree" model="ir.ui.view">
        <field name="name">recinto.tree</field>
        <field name="model">ce_base.recinto</field>
        <field name="arch" type="xml">
            <tree string="RECINTO">
                <!-- <field name="nom_provincia"/> -->
                <field name="nom_canton"/>
                <field name="nom_parroquia"/>
                <field name="nom_recinto"/>
                <field name="juntas_count"/>
                <field name="jun_mas"/>
                <field name="juntas_masculino_count"/>
                <field name="jun_fem"/>
                <field name="juntas_femenino_count"/>
                <field name="juntas_porc_asignacion"  widget="progressbar"/>
                <!-- <field name="coordinador_ids"/> -->
                <field name="cedula" string="Cedula Coordinador" optional="hide"/>
                <field name="tipo_ingreso_coordinador" string="Tipo de Ingreso Coordinador" optional="hide"/>
                <field name="estado_coordinador" string="Estado Coordinador" optional="hide"/>
                <field name="distrito" string="Distrito" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_recinto_form" model="ir.ui.view">
        <field name="name">recinto.form</field>
        <field name="model">ce_base.recinto</field>
        <field name="arch" type="xml">
            <form string="RECINTO">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_coordinador" type="object" class="oe_stat_button" icon="fa-users"> 
                            <field string="Coordinador" name="coordinador_count" widget="statinfo"  options="{'no_create': True, 'no_create_edit':True}"/>
                        </button>
                        <button name="action_calculo_masculino" type="object" class="oe_stat_button" icon="fa-male">
                            <div class="o_field_widget o_stat_info mr4">
                                <span class="o_stat_text">desde:</span>
                                <span class="o_stat_text">hasta:</span>
                            </div>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="juntas_masculino_count"/>
                                </span>
                                <span class="o_stat_value">
                                    <field name="jun_mas"/>
                                </span>
                            </div>
                        </button>
                        <button name="action_calculo_femenino" type="object" class="oe_stat_button" icon="fa-female">
                            <div class="o_field_widget o_stat_info mr4">
                                <span class="o_stat_text">desde:</span>
                                <span class="o_stat_text">hasta:</span>
                            </div>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="juntas_femenino_count"/>
                                </span>
                                <span class="o_stat_value">
                                    <field name="jun_fem"/>
                                </span>
                            </div>
                        </button>
                        <button name="action_coordinador" type="object" class="oe_stat_button" icon="fa-tachometer">
                            <field name="juntas_porc_asignacion" widget="statinfo"/>
                        </button>
                        <button name="action_mostrar_juntas" type="object" class="oe_stat_button" icon="fa-table">
                            <field string="# Juntas" name="juntas_count" widget="statinfo"/>
                        </button>

                    </div>
                    <div class="oe_title">
                        <label for="nom_recinto" string="Nombre" class="oe_edit_only"/>
                        <h1>
                            <field name="nom_recinto" placeholder="Nombre del Recinto"/>
                        </h1>
                    </div>
                        <group>
                            <group>
                                <field name="nom_provincia"/>
                                <field name="nom_canton"/>
                                <field name="nom_parroquia"/>
                                <field name="nom_zona"/>
                            </group>
                            <group>
                                <field name="jun_fem"/>
                                <field name="jun_mas"/>
                                <field name="num_junr"/>
                                <field name="num_electores"/>
<!--                                <field name="coordinador_ids"/>-->
                                <!-- <field name="juntas_ids"/> -->
                            </group>
                            <field name="dcdr_ids"/>
                        </group>
                      
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_recinto_graph" model="ir.ui.view">
        <field name="model">ce_base.recinto</field>
        <field name="arch" type="xml">
            <graph string="coordinador">
                <!-- <field name="coordinador_ids"/> -->
            </graph>
        </field>
    </record>

    <record id="view_recinto_pivot" model="ir.ui.view">
        <field name="model">ce_base.recinto</field>
        <field name="arch" type="xml">
            <pivot string="coordinador">
                <!-- <field name="coordinador_ids"/> -->
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_recinto">
        <field name="name">RECINTO</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_base.recinto</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add a Recinto.
            </p>
        </field>
    </record>

</odoo>