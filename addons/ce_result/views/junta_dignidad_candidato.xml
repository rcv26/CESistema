<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resultado_tree" model="ir.ui.view">
        <field name="name">junta_dignidad_candidato.tree</field>
        <field name="model">ce_result.junta_dignidad_candidato</field>
        <field name="arch" type="xml">
            <tree string="Resultados">
                <field name="junta_dignidad_id"/>
                <field name="candidato_id"/>
                <field name="voto"/>
            </tree>
        </field>
    </record>

    <record id="view_resultado_graph" model="ir.ui.view">
        <field name="model">ce_result.junta_dignidad_candidato</field>
        <field name="arch" type="xml">
            <graph>
                <field name="candidato_id"/>
                <field name="voto"/>            
            </graph>
        </field>
    </record>

    <record id="view_resultado_pivot" model="ir.ui.view">
        <field name="model">ce_result.junta_dignidad_candidato</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="voto"/>            
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_resultado">
        <field name="name">Resultados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_result.junta_dignidad_candidato</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="view_id" ref="ce_result.view_resultado_tree"/>
        <!-- <field name="domain">[('state','=','a')]</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>
</odoo>