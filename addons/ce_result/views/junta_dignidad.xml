                <field name="dignidad_id"/>
            </pivot>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_control_calidad">
        <field name="name">Control de Calidad</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_result.junta_dignidad</field>
        <field name="view_mode">tree,pivot,graph</field>
        <field name="search_view_id" ref="view_ingreso_PDF_filter"/>
        <field name="view_id" ref="ce_result.view_control_calidad_tree"/>
        <field name="domain">[('state','in',['d','c','i'])]</field>
        <field name="context">{'tarea':'c',}</field>
        <field name="view_ids" eval="[(5, 0, 0),
               (0, 0, {'view_mode': 'tree', 'view_id': ref('view_control_calidad_tree')}),
               (0, 0, {'view_mode': 'form', 'view_id': ref('view_control_calidad_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

</odoo>