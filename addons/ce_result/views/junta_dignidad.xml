<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- registro de acta -->
    <record id="view_registro_acta_tree" model="ir.ui.view">
        <field name="name">junta_dignidad.tree</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <tree string="Registro de Actas">
                <header>
                    <button name="action_registrar" string = "Registrar" class="oe_highlight" type="object"/>
                </header>
                <field name="dignidad_id"/>
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <field name="total_sufragantes" optional= "hide"/>
                <field name="votos_blancos" optional= "hide"/>
                <field name="votos_nulos" optional= "hide"/>
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_registro_acta_filter" model="ir.ui.view">
        <field name="name">junta_dignidad.filter</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Acta">
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <separator/>
                <filter string="Hombre" name="genero" domain="[('genero','=','M')]"/>
                <filter string="Mujer" name="genero" domain="[('genero','=','F')]"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_registro_acta">
        <field name="name">Registro de Acta</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_result.junta_dignidad</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_registro_acta_filter"/>
        <field name="view_id" ref="ce_result.view_registro_acta_tree"/>
        <field name="domain">[('state','=','a')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>


<!-- ingreso de resultados -->
    <record id="view_junta_dignidad_tree" model="ir.ui.view">
        <field name="name">junta_dignidad.tree</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <tree string="Consolidacion de Resultados">
                <field name="dignidad_id"/>
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <field name="total_sufragantes" optional= "hide"/>
                <field name="votos_blancos" optional= "hide"/>
                <field name="votos_nulos" optional= "hide"/>
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_junta_dignidad_form" model="ir.ui.view">
        <field name="name">junta_dignidad.form</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <form string="Juntas x Dignidad" options="{'initial_mode': 'in_line'}">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="dignidad_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cod_provincia" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_canton" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_parroquia" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_zona" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="genero" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="numero_junta" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                        </group>
                        <group>
                            <field name="dignidad_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="total_sufragantes" widget="integer" attrs="{'readonly': [('state', '=', 'd')]}"/>
                            <field name="votos_blancos" widget="integer" attrs="{'readonly': [('state', '=', 'd')]}"/>
                            <field name="votos_nulos" widget='integer' attrs="{'readonly': [('state', '=', 'd')]}"/>
                            <field name="state" invisible="1"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="candidato_ids" nolabel="1" mode="tree" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}" attrs="{'readonly': [('state', '=', 'd')]}" >
                                <tree string="CANDIDATOS" editable="bottom" multi_edit="1" >
                                    <field name="candidato_id" readonly="1" string="Candidato" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}" />
                                    <field name="voto" string="Votos"/>
                                </tree>
                            </field>
                        </group>
                        <group >
                            <field name="file" nolabel="1" widget="pdf_viewer" readonly="1"/>
                        </group>
                    </group>

                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>       
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_junta_dignidad_filter" model="ir.ui.view">
        <field name="name">junta_dignidad.filter</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Acta">
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <separator/>
                <filter string="Hombre" name="genero" domain="[('genero','=','M')]"/>
                <filter string="Mujer" name="genero" domain="[('genero','=','F')]"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_junta_dignidad">
        <field name="name">Consolidacion de Resultados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_result.junta_dignidad</field>
        <field name="view_mode">form,tree</field>
        <field name="search_view_id" ref="view_junta_dignidad_filter"/>
        <field name="view_id" ref="ce_result.view_junta_dignidad_tree"/>
        <field name="domain">[('state','in',['a', 'r'])]</field>
        <field name="context">{'tarea':'d',}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>

