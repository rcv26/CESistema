    <record id="view_ingreso_PDF_filter" model="ir.ui.view">
        <field name="name">junta_dignidad.filter</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <search string="Acta">
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <separator/>
                <filter string="Hombre" name="genero" domain="[('genero','=','M')]"/>
                <filter string="Mujer" name="genero" domain="[('genero','=','F')]"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_ingreso_PDF">
        <field name="name">Ingreso de PDF de Acta</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ce_result.junta_dignidad</field>
        <field name="view_mode">form,tree</field>
        <field name="search_view_id" ref="view_ingreso_PDF_filter"/>
        <field name="view_id" ref="ce_result.view_junta_dignidad_tree"/>
        <field name="context">{'tarea':'f',}</field>
        <field name="view_ids" eval="[(5, 0, 0),
               (0, 0, {'view_mode': 'tree', 'view_id': ref('view_ingreso_PDF_tree')}),
               (0, 0, {'view_mode': 'form', 'view_id': ref('view_ingreso_PDF_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Record Found
            </p>
            <p>
                Click to add.
            </p>
        </field>
    </record>


<!-- revision de acta control de calidad-->
    <record id="view_control_calidad_tree" model="ir.ui.view">
        <field name="name">junta_dignidad.tree</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <tree string="Control de Calidad">
                <field name="dignidad_id"/>
                <field name="cod_canton"/>
                <field name="cod_parroquia"/>
                <field name="cod_zona"/>
                <field name="cod_recinto"/>
                <field name="genero"/>
                <field name="numero_junta"/>
                <field name="tiene_inconsistencia" widget="buttom"/>
                <field name="total_sufragantes" optional= "hide"/>
                <field name="votos_blancos" optional= "hide"/>
                <field name="votos_nulos" optional= "hide"/>

                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="view_control_calidad_form" model="ir.ui.view">
        <field name="name">junta_dignidad.form</field>
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sin_novedad" string = "Acta sin Novedad" class="oe_highlight" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="dignidad_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="cod_provincia" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_canton" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_parroquia" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="cod_zona" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="genero" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="numero_junta" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="tiene_inconsistencia" widget="toogle"/>

                        </group>
                        <group>
                            <field name="dignidad_id" attrs="{'readonly': [('id', '!=', False)]}" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"/>
                            <field name="total_sufragantes" widget="integer" />
                            <field name="votos_blancos" widget="integer" />
                            <field name="votos_nulos" widget='integer' />
                            <field name="state" invisible="1"/>
                            <field name="file_name" invisible="1"/>
                            <field name="observacion"/>

                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="candidato_ids" nolabel="1" mode="tree" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}" >
                                <tree string="CANDIDATOS" editable="bottom" multi_edit="1" >
                                    <field name="candidato_id" readonly="1" string="Candidato" options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}" />
                                    <field name="voto" string="Votos"/>
                                </tree>
                            </field>
                        </group>
                        <group >
                            <field name="file" nolabel="1" widget="pdf_viewer" readonly="1"/>
                            
                        </group>

                    </group>

                    
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>       
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_control_calidad_graph" model="ir.ui.view">
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
            <graph>
                <field name="dignidad_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_control_calidad_pivot" model="ir.ui.view">
        <field name="model">ce_result.junta_dignidad</field>
        <field name="arch" type="xml">
